# Copia este fichero a .env y rellena los valores. .env NUNCA se commitea.

# Etherscan V2 — todas las consultas a la cadena van por aquí (chainid 137, Polygon)
ETHERSCAN_API_KEY=

# Maestro de inmuebles, publicado como CSV desde Google Sheets
# (Archivo → Compartir → Publicar en la web → CSV)
GSHEET_CSV_URL=

# Hoja con las wallets conocidas de Reental, también como CSV. Opcional:
# sin ella, la herramienta usa reental_addresses.json
GSHEET_WALLETS_URL=

# Wallet de custodia del stock OTC
OTC_WALLET=0xce0719ec1bda336ba069c6961ad167767829301a

# PIN del panel de precios mínimos OTC
OTC_ADMIN_PIN=

# NOTA: el almacén OTC (reservas, ofertas, precios) va por gspread y necesita
# además la credencial de servicio de Google. En local, en .streamlit/secrets.toml;
# en Streamlit Cloud, en Settings → Secrets, bajo [gcp_service_account].
