# Copia este fichero a .env y rellena los valores. .env NUNCA se commitea.

# Etherscan V2 — todas las consultas a la cadena van por aquí (chainid 137, Polygon)
ETHERSCAN_API_KEY=

# Maestro de inmuebles, publicado como CSV desde Google Sheets
# (Archivo → Compartir → Publicar en la web → CSV)
GSHEET_CSV_URL=

# Hoja con las wallets conocidas de Reental, también como CSV. Opcional:
# sin ella, la herramienta usa reental_addresses.json
GSHEET_WALLETS_URL=

# Wallet de custodia del stock OTC
OTC_WALLET=0xce0719ec1bda336ba069c6961ad167767829301a

# PIN del panel de precios mínimos OTC
OTC_ADMIN_PIN=

# NOTA: el almacén OTC (reservas, ofertas, precios) va por gspread y necesita
# además la credencial de servicio de Google. En local, en .streamlit/secrets.toml;
# en Streamlit Cloud, en Settings → Secrets, bajo [gcp_service_account].

# Enlace al Excel de OFF-RAMP que el aviso de protocolo OTC muestra al comercial.
# La herramienta NO lee datos de esa hoja: solo la enlaza. Va aquí y no en el
# código porque contiene nombre, correo, IBAN y certificado de titularidad de
# cada inversor, y el repositorio es público. Sin esta variable el protocolo se
# muestra igual, sin enlace.
OFFRAMP_SHEET_URL=

# Clave para seudonimizar las direcciones de los datos del mercado secundario
# (scripts/anonimizar_secundario.py). Mínimo 16 caracteres, generada al azar.
# Sin ella el script se niega a ejecutarse: un hash sin clave sería reversible
# por fuerza bruta, porque la lista de direcciones candidatas es pública en la
# cadena. Si se pierde, los seudónimos nuevos dejarán de cuadrar con los
# antiguos y el recuento de inversores únicos se duplicará.
SEUDONIMO_SALT=
